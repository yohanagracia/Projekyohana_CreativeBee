<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin akses internet untuk WebView -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjekMobileYohana">

        <!-- Splash Screen sebagai halaman pertama -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman utama -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman login -->
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman katalog produk -->
        <activity
            android:name=".CatalogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman workshop clay -->
        <activity
            android:name=".WorkshopActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman website -->
        <activity
            android:name=".WebsiteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman profil developer -->
        <activity
            android:name=".ProfileDeveloperActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
