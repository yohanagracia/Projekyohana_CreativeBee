<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BRAND HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/bee_logo"
                android:contentDescription="Creative Bee Logo"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Creative Bee"
                    android:textColor="#754A2D"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Handmade with love ♡"
                    android:textColor="#A17A5D"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DECORATIVE HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="@drawable/bg_catalog_welcome"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✿       🐝       ✿"
                android:textSize="25sp"/>

            <ImageView
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/bee_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Creative Bee"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="A Little World of Handmade"
                android:textColor="#754A2D"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="Discover adorable clay creations, made with creativity and love."
                android:textColor="#946E52"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="♡  Cute  •  Creative  •  Handmade  ♡"
                android:textColor="#C47758"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- BOTTOM DECORATION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Ready to find your favorite?"
            android:textColor="#754A2D"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnOpenCatalog"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_catalog_button"
            android:backgroundTint="@null"
            android:text="Buka Katalog Lengkap  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Made with love by Creative Bee ♡"
            android:textColor="#B18C70"
            android:textSize="11sp"/>

    </LinearLayout>
</ScrollView>
